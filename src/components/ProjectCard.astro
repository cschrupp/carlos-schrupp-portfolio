---
import type { Project, ProjectCardPlacement } from "../data/projects";
import { withBase } from "../lib/paths";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  placement: ProjectCardPlacement & { project: Project };
  compact?: boolean;
}

const { placement, compact = false } = Astro.props;
const { project } = placement;
const target = `/portfolio/${project.slug}${placement.phaseAnchor ? `#${placement.phaseAnchor}` : ""}`;
---

<article class:list={["project-card", `accent-${project.accent}`, { compact, "has-visual": Boolean(project.visual) }]}>
  {project.visual && (
    <a class="project-card-visual" href={withBase(target)} aria-label={`Open ${placement.title}`}>
      <ProjectVisual visual={project.visual} compact />
    </a>
  )}
  <div class="project-card-body">
    <div class="project-card-meta"><span>{placement.eyebrow}</span><span class="status-badge">{placement.status}</span></div>
    <h3><a href={withBase(target)}>{placement.title}</a></h3>
    <p class="project-summary">{placement.summary}</p>
    <p class="project-card-role">{project.role}</p>
    <a class="text-link" href={withBase(target)}>View project <span aria-hidden="true">→</span></a>
  </div>
</article>
