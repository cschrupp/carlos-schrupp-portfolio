---
import type { Project, ProjectCardPlacement } from "../data/projects";
import { withBase } from "../lib/paths";
import ProjectVisual from "./ProjectVisual.astro";

interface Props {
  placement: ProjectCardPlacement & { project: Project };
  compact?: boolean;
}

const { placement, compact = false } = Astro.props;
const { project } = placement;
const target = `/portfolio/${project.slug}${placement.phaseAnchor ? `#${placement.phaseAnchor}` : ""}`;
---

<article class:list={["project-card", `accent-${project.accent}`, { compact }, `mode-${project.detailMode}`]}>
  <a class="project-card-visual" href={withBase(target)} aria-label={`Open ${placement.title}`}>
    <ProjectVisual project={project} compact />
  </a>
  <div class="project-card-body">
    <div class="project-card-meta">
      <span>{placement.eyebrow}</span>
      <span class="status-badge">{placement.status}</span>
    </div>
    <h3><a href={withBase(target)}>{placement.title}</a></h3>
    <p class="project-summary">{placement.summary}</p>
    <p class="project-card-role">{project.role}</p>
    <div class="tag-list" aria-label={`${placement.title} technologies`}>
      {project.technologies.slice(0, compact ? 3 : 5).map((technology) => <span>{technology}</span>)}
    </div>
    <a class="text-link" href={withBase(target)}>
      {project.detailMode === "preview" ? "View current work" : "View project"} <span aria-hidden="true">→</span>
    </a>
  </div>
</article>
