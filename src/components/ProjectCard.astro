---
import type { Project } from "../data/projects";
import { withBase } from "../lib/paths";

interface Props {
  project: Project;
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
---

<article class:list={["project-card", `accent-${project.accent}`, { featured }]}>
  <a class="project-visual" href={withBase(`/portfolio/${project.slug}`)} aria-label={`Read the ${project.title} case study`}>
    {project.slug === "wellplot" ? (
      <img src={withBase(project.image)} alt={project.imageAlt} width="993" height="980" loading="lazy" />
    ) : (
      <div class="codingrabbit-card-art" aria-hidden="true">
        <span>Authenticated learning</span>
        <span>Course-grounded RAG</span>
        <span>Guarded inference</span>
        <span>Offline evaluation</span>
      </div>
    )}
  </a>
  <div class="project-card-body">
    <div class="project-card-meta">
      <span>{project.eyebrow}</span>
      <span>{project.year}</span>
    </div>
    <h3><a href={withBase(`/portfolio/${project.slug}`)}>{project.title}</a></h3>
    <p class="project-summary">{project.summary}</p>
    <p>{project.description}</p>
    <div class="tag-list" aria-label={`${project.title} technologies`}>
      {project.technologies.slice(0, featured ? 6 : 4).map((technology) => <span>{technology}</span>)}
    </div>
    <a class="text-link" href={withBase(`/portfolio/${project.slug}`)}>Read case study <span aria-hidden="true">→</span></a>
  </div>
</article>
