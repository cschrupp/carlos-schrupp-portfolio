---
import type { ProjectVisual as Visual } from "../data/projects";
import { withBase } from "../lib/paths";

interface Props {
  visual?: Visual;
  compact?: boolean;
  eager?: boolean;
}

const { visual, compact = false, eager = false } = Astro.props;
const imageSrc = visual?.src.startsWith("http") ? visual.src : visual?.src ? withBase(visual.src) : undefined;
---

{visual && imageSrc && (
  <figure class:list={["project-visual-frame", { compact }]}>
    <img src={imageSrc} alt={visual.alt} width={visual.width} height={visual.height} loading={eager ? "eager" : "lazy"} decoding="async" />
    {visual.caption && <figcaption class="visual-caption">{visual.caption}</figcaption>}
  </figure>
)}
