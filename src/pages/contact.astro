---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profile } from "../data/profile";
---

<BaseLayout title="Contact — Carlos Schrupp" description="Contact Carlos Schrupp about Applied AI & Computational Engineering, energy and industrial AI work.">
  <section class="contact-page"><div class="shell contact-page-grid">
    <div><p class="eyebrow">Contact</p><h1>Contact</h1><p class="contact-intro">I am interested in Applied AI & Computational Engineering roles and consulting work, especially where energy or industrial domain knowledge changes the technical approach.</p></div>
    <div class="contact-options">
      {profile.email && <a href={`mailto:${profile.email}`}><span>Email</span><strong>{profile.email}</strong><i aria-hidden="true">→</i></a>}
      <a href={profile.linkedin} target="_blank" rel="noreferrer"><span>LinkedIn</span><strong>Professional profile</strong><i aria-hidden="true">↗</i></a>
      <a href={profile.github} target="_blank" rel="noreferrer"><span>GitHub</span><strong>Open-source work</strong><i aria-hidden="true">↗</i></a>
    </div>
  </div></section>
</BaseLayout>
