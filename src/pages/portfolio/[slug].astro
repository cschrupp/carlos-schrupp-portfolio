---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectVisual from "../../components/ProjectVisual.astro";
import { projects, type Project } from "../../data/projects";
import { withBase } from "../../lib/paths";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const currentIndex = projects.findIndex((item) => item.slug === project.slug);
const nextProject = projects[(currentIndex + 1) % projects.length];
const heroMeta = project.heroMeta ?? [
  { label: "Status", value: project.status },
  { label: "Role", value: project.role },
  { label: "Context", value: project.teamContext },
  { label: "Dates", value: project.dates },
  {
    label: "Depth",
    value:
      project.detailMode === "deep"
        ? "Technical case study"
        : project.detailMode === "compact"
          ? "Compact project page"
          : "In-progress preview",
  },
];
---

<BaseLayout title={`${project.title} — Carlos Schrupp`} description={project.description}>
  <article class:list={["project-page", `accent-${project.accent}`, `detail-${project.detailMode}`]}>
    <header class="case-hero">
      <div class="shell">
        <a class="breadcrumb" href={withBase("/portfolio")}><span aria-hidden="true">←</span> Portfolio</a>
        <div class="case-hero-grid">
          <div>
            <p class="eyebrow">{project.eyebrow}</p>
            <h1>{project.title}</h1>
            <p class="case-summary">{project.summary}</p>
            <p class="case-description">{project.description}</p>
            <div class="project-links">
              {project.links.map((link, index) => (
                <a
                  class:list={["button", index === 0 ? "button-primary" : "button-secondary"]}
                  href={link.href}
                  target="_blank"
                  rel="noreferrer"
                >
                  {link.label}<span aria-hidden="true">↗</span>
                </a>
              ))}
            </div>
          </div>
          <dl class="case-meta">
            {heroMeta.map((item) => (
              <div><dt>{item.label}</dt><dd>{item.value}</dd></div>
            ))}
          </dl>
        </div>
        {project.phases && (
          <nav class="phase-nav" aria-label={`${project.title} phases`}>
            {project.phases.map((phase) => (
              <a href={`#${phase.id}`}>
                <span>{phase.status}</span>
                <strong>{phase.label}</strong>
                <small>{phase.summary}</small>
              </a>
            ))}
          </nav>
        )}
      </div>
    </header>

    <section class="case-media">
      <div class="shell">
        <ProjectVisual project={project} />
      </div>
    </section>

    <section class="case-facts" aria-label={`${project.title} evidence facts`}>
      <div class="shell fact-grid">
        {project.facts.map((fact) => (
          <article>
            <p class="fact-value">{fact.value}</p>
            <h2>{fact.label}</h2>
            <p>{fact.detail}</p>
          </article>
        ))}
      </div>
    </section>

    <div class="project-sections">
      {project.sections.map((section, index) => (
        <section
          id={section.id}
          class:list={[
            "case-section",
            `section-kind-${section.kind}`,
            { "case-section-tinted": index % 2 === 1 },
            { "case-section-dark": section.kind === "contribution" },
          ]}
        >
          <div class="shell case-two-column">
            <div class="case-section-heading">
              {section.eyebrow && <p class="eyebrow">{section.eyebrow}</p>}
              <h2>{section.title}</h2>
              {section.opening && <p class="section-opening">{section.opening}</p>}
            </div>
            <div class="case-section-body">
              {section.paragraphs?.map((paragraph) => <p class="large-prose">{paragraph}</p>)}
              {section.bullets && (
                <ul class:list={["section-list", { "contribution-list": section.kind === "contribution" }]}>
                  {section.bullets.map((item) => <li>{item}</li>)}
                </ul>
              )}
              {section.facts && (
                <div class="inline-facts">
                  {section.facts.map((fact) => (
                    <article>
                      <strong>{fact.value}</strong>
                      <span>{fact.label}</span>
                      <p>{fact.detail}</p>
                    </article>
                  ))}
                </div>
              )}
              {section.caveat && (
                <aside class="caveat">
                  <strong>Boundary</strong>
                  <p>{section.caveat}</p>
                </aside>
              )}
            </div>
          </div>
        </section>
      ))}
    </div>

    <section class="technology-band">
      <div class="shell technology-band-grid">
        <div>
          <p class="eyebrow">Technical stack</p>
          <h2>Tools are secondary to the boundary they serve.</h2>
        </div>
        <div class="tag-list tag-list-large" aria-label={`${project.title} technologies`}>
          {project.technologies.map((technology) => <span>{technology}</span>)}
        </div>
      </div>
    </section>

    <footer class="case-footer">
      <div class="shell case-footer-grid">
        <p>{project.sourceNote}</p>
        <a href={withBase(`/portfolio/${nextProject.slug}`)}>
          <span>Next project</span>
          <strong>{nextProject.title} →</strong>
        </a>
      </div>
    </footer>
  </article>
</BaseLayout>
