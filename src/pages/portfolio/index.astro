---
import ProjectCard from "../../components/ProjectCard.astro";
import SectionHeading from "../../components/SectionHeading.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getPlacements, getProject } from "../../data/projects";

const featured = getPlacements("featured");
const currentResearch = [getProject("tension-modeling")!, getProject("relay")!];
---

<BaseLayout title="Portfolio — Carlos Schrupp" description="Applied AI, scientific software, computational engineering and selected UC Berkeley MIDS work by Carlos Schrupp.">
  <section class="page-hero portfolio-hero"><div class="shell page-hero-grid"><div><p class="eyebrow">Portfolio</p><h1>Selected technical work</h1></div><p class="page-intro">Four projects show the strongest current work. Two additional research programs are included below while their next publishable artifacts are being prepared.</p></div></section>
  <section class="section portfolio-collection"><div class="shell"><SectionHeading eyebrow="Projects" title="Featured projects" /><div class="featured-grid">{featured.map((placement) => <ProjectCard placement={placement} />)}</div></div></section>
  <section class="section current-research-section"><div class="shell"><SectionHeading eyebrow="Current work" title="Current research" /><div class="research-list">{currentResearch.map((project) => <article><div><h3>{project.title}</h3><span>{project.status}</span></div><p>{project.summary}</p></article>)}</div></div></section>
</BaseLayout>
